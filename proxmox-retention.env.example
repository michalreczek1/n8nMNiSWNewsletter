# Merge these non-secret settings into /etc/n8n/n8n.env.
# Preserve the other existing variables and credentials in that file.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=48
EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=15
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15
