[Unit]
Description=n8n inspection and anomaly-only email report
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/n8n-watchdog/mail.env
ExecStart=/usr/bin/flock -n /run/n8n-watchdog.lock /opt/n8n-watchdog/venv/bin/python /opt/n8n-watchdog/n8n_watchdog.py
TimeoutStartSec=240
Restart=on-failure
RestartSec=15min
